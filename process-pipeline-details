<!-- LEVEL 4: DETAIL ZOOM-IN FRAGMENT -->
<style>
  .lvl4-container {
    width: 1400px;
    height: 700px;
    position: relative;
    color: var(--text-main);
    font-family: var(--font-mono);
  }

  .lvl4-header-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 16px;
    margin-bottom: 24px;
  }

  .lvl4-title h2 {
    font-size: 1.2rem;
    color: var(--color-fred);
    margin: 0 0 4px 0;
    text-transform: uppercase;
  }
  .lvl4-title p {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin: 0;
  }

  /* SIMULATION CONTROLS */
  .lvl4-sim-controls {
    display: flex;
    gap: 10px;
    background: rgba(255, 255, 255, 0.03);
    padding: 8px 12px;
    border-radius: 6px;
    border: 1px solid var(--border-color);
  }

  .lvl4-sim-btn {
    background: transparent;
    border: 1px solid var(--border-color);
    color: var(--text-muted);
    padding: 6px 12px;
    font-size: 0.75rem;
    font-family: var(--font-mono);
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .lvl4-sim-btn.active-happy { background: rgba(0, 255, 204, 0.15); border-color: var(--cyber-glow); color: var(--cyber-glow); }
  .lvl4-sim-btn.active-auth { background: rgba(255, 0, 127, 0.15); border-color: var(--color-internal); color: var(--color-internal); }
  .lvl4-sim-btn.active-data { background: rgba(255, 183, 3, 0.15); border-color: var(--cyber-alert); color: var(--cyber-alert); }

  /* PIPELINE GRID */
  .lvl4-pipeline-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
    margin-bottom: 24px;
  }

  .lvl4-phase-card {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    padding: 16px;
    cursor: pointer;
    position: relative;
    transition: all 0.25s ease;
    box-shadow: 0 4px 15px rgba(0,0,0,0.5);
  }

  .lvl4-phase-card:hover, .lvl4-phase-card.selected {
    border-color: var(--cyber-glow);
    box-shadow: 0 0 15px rgba(0, 255, 204, 0.2);
    transform: translateY(-2px);
  }

  .lvl4-phase-card.error-state {
    border-color: var(--color-internal) !important;
    box-shadow: 0 0 15px rgba(255, 0, 127, 0.25) !important;
  }

  .lvl4-phase-card.alert-state {
    border-color: var(--cyber-alert) !important;
    box-shadow: 0 0 15px rgba(255, 183, 3, 0.25) !important;
  }

  .lvl4-phase-num {
    font-size: 0.65rem;
    color: var(--cyber-glow);
    font-weight: bold;
    letter-spacing: 1px;
  }

  .lvl4-phase-title {
    font-size: 0.9rem;
    font-weight: bold;
    color: #fff;
    margin: 8px 0;
  }

  .lvl4-phase-desc {
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  .lvl4-badge {
    display: inline-block;
    margin-top: 12px;
    font-size: 0.65rem;
    padding: 3px 8px;
    border-radius: 3px;
    font-weight: bold;
  }

  .badge-ok { background: rgba(0, 255, 204, 0.15); color: var(--cyber-glow); border: 1px solid rgba(0, 255, 204, 0.3); }
  .badge-err { background: rgba(255, 0, 127, 0.15); color: var(--color-internal); border: 1px solid rgba(255, 0, 127, 0.3); }
  .badge-warn { background: rgba(255, 183, 3, 0.15); color: var(--cyber-alert); border: 1px solid rgba(255, 183, 3, 0.3); }

  /* DETAIL INSPECTOR */
  .lvl4-inspector {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    padding: 24px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.5);
  }

  .lvl4-inspector-col h3 {
    font-size: 0.95rem;
    color: var(--cyber-glow);
    margin: 0 0 12px 0;
    border-bottom: 1px dashed rgba(255, 255, 255, 0.1);
    padding-bottom: 8px;
  }

  .lvl4-list { list-style: none; padding: 0; margin: 0; font-size: 0.8rem; }
  .lvl4-list li { margin-bottom: 10px; line-height: 1.5; color: var(--text-muted); }
  .lvl4-list strong { color: #fff; }

  .lvl4-code {
    background: #050508;
    border: 1px solid var(--border-color);
    padding: 16px;
    font-size: 0.75rem;
    color: #a9b7c6;
    overflow-x: auto;
    white-space: pre-wrap;
    border-radius: 4px;
  }
</style>

<div class="lvl4-container">
  <!-- HEADER & CONTROLS -->
  <div class="lvl4-header-bar">
    <div class="lvl4-title">
      <h2>[ LEVEL 4 // DETAIL ZOOM-IN: FRED GDP INGESTION ]</h2>
      <p>Systemarchitektur: Auth-Validierung, REST-Polling, Cleanse, Multi-Currency & Parquet DWH Storage</p>
    </div>

    <!-- SIMULATOR TOGGLES -->
    <div class="lvl4-sim-controls">
      <span style="font-size: 0.7rem; color: var(--text-muted); align-self: center;">Szenario:</span>
      <button class="lvl4-sim-btn active-happy" id="btn-happy" onclick="setScenario('happy')">✓ Happy Path</button>
      <button class="lvl4-sim-btn" id="btn-auth" onclick="setScenario('auth')">⚠ Error: Auth Key (403)</button>
      <button class="lvl4-sim-btn" id="btn-data" onclick="setScenario('data')">⚡ Warn: Missing Val (".")</button>
    </div>
  </div>

  <!-- PIPELINE FLOW TILES -->
  <div class="lvl4-pipeline-grid">
    <div class="lvl4-phase-card selected" id="card-p1" onclick="selectPhase('p1')">
      <div class="lvl4-phase-num">PHASE 01</div>
      <div class="lvl4-phase-title">Auth & Env</div>
      <div class="lvl4-phase-desc">GCP Service Account & FRED Hex API-Key Validierung.</div>
      <span class="lvl4-badge badge-ok" id="badge-p1">KEY VALIDATED</span>
    </div>

    <div class="lvl4-phase-card" id="card-p2" onclick="selectPhase('p2')">
      <div class="lvl4-phase-num">PHASE 02</div>
      <div class="lvl4-phase-title">Endpoint Polling</div>
      <div class="lvl4-phase-desc">Request für US BIP (GDPC1) & DE BIP.</div>
      <span class="lvl4-badge badge-ok" id="badge-p2">HTTP 200 OK</span>
    </div>

    <div class="lvl4-phase-card" id="card-p3" onclick="selectPhase('p3')">
      <div class="lvl4-phase-num">PHASE 03</div>
      <div class="lvl4-phase-title">Cleansing</div>
      <div class="lvl4-phase-desc">Schema-Check & Umgang mit "." (Missing Data).</div>
      <span class="lvl4-badge badge-ok" id="badge-p3">SCHEMA MATCH</span>
    </div>

    <div class="lvl4-phase-card" id="card-p4" onclick="selectPhase('p4')">
      <div class="lvl4-phase-num">PHASE 04</div>
      <div class="lvl4-phase-title">Harmonization</div>
      <div class="lvl4-phase-desc">Währungs- (USD/EUR) & Einheiten-Anpassung.</div>
      <span class="lvl4-badge badge-ok" id="badge-p4">TRANSFORM OK</span>
    </div>

    <div class="lvl4-phase-card" id="card-p5" onclick="selectPhase('p5')">
      <div class="lvl4-phase-num">PHASE 05</div>
      <div class="lvl4-phase-title">Parquet Storage</div>
      <div class="lvl4-phase-desc">Partitionierter Write in Cold DWH via DuckDB.</div>
      <span class="lvl4-badge badge-ok" id="badge-p5">PARQUET WRITTEN</span>
    </div>
  </div>

  <!-- INSPECTOR PANEL -->
  <div class="lvl4-inspector">
    <div class="lvl4-inspector-col">
      <h3 id="insp-title">Phase 1: Environment & Credential Check</h3>
      <ul class="lvl4-list" id="insp-specs"></ul>
    </div>
    <div class="lvl4-inspector-col">
      <h3 id="insp-code-title">Execution Logs & Code Sample</h3>
      <div class="lvl4-code" id="insp-code"></div>
    </div>
  </div>
</div>

<script>
  (function() {
    let currentScenario = 'happy';
    let currentPhase = 'p1';

    const phaseData = {
      happy: {
        p1: {
          badgeClass: 'badge-ok', badgeText: 'KEY VALIDATED',
          title: 'Phase 1: Environment & Credential Check',
          specs: [
            '<strong>Auth-Methode:</strong> API Key Parameter Authentication',
            '<strong>FRED API Key:</strong> 32-stelliger Hex-Code aus `.env` File (`FRED_API_KEY`)',
            '<strong>Infrastruktur:</strong> GCP Service Account Identity Token zur Prozess-Rechteverwaltung',
            '<strong>Prüfpfad:</strong> Stellt sicher, dass der Key syntaktisch korrekt geladen ist.'
          ],
          codeTitle: 'Python Environment Inspector',
          code: `import os\nfrom dotenv import load_dotenv\n\nload_dotenv()\nFRED_KEY = os.getenv("FRED_API_KEY")\n\nif not FRED_KEY or len(FRED_KEY) != 32:\n    raise ValueError("CRITICAL: Invalid or missing FRED_API_KEY!")\nprint("[AUTH_OK] FRED_API_KEY successfully loaded.")`
        },
        p2: {
          badgeClass: 'badge-ok', badgeText: 'HTTP 200 OK',
          title: 'Phase 2: Endpoint Resolution & Requesting',
          specs: [
            '<strong>Base URL:</strong> `https://api.stlouisfed.org/fred/series/observations`',
            '<strong>Target Series US BIP:</strong> `GDPC1` (Real Gross Domestic Product, Billions $, Quarterly)',
            '<strong>Target Series DE BIP:</strong> `CLVMNACSCAB1GQDE` (National Currency)',
            '<strong>Rate Limiting:</strong> FRED erlaubt bis zu 120 Requests/Min.'
          ],
          codeTitle: 'cURL & API Request Target',
          code: `GET /fred/series/observations?\n  series_id=GDPC1&\n  api_key=abcdef12345678901234567890123456&\n  file_type=json&\n  observation_start=2020-01-01\nHost: api.stlouisfed.org\n\nResponse: 200 OK (Content-Type: application/json)`
        },
        p3: {
          badgeClass: 'badge-ok', badgeText: 'SCHEMA MATCH',
          title: 'Phase 3: Cleansing & Missing-Value Treatment',
          specs: [
            '<strong>Empfangenes Schema:</strong> `{"date": "YYYY-MM-DD", "value": "STRING"}`',
            '<strong>Cleansing-Regel:</strong> FRED sendet bei unvollständigen Datenpunkten oft ein Punkt `"."` als String.',
            '<strong>Typ-Konvertierung:</strong> Umwandlung von Strings in `float64`.',
            '<strong>Handling:</strong> Ersetzung von `"."` durch `NaN` -> Ausführung von `Forward-Fill`.'
          ],
          codeTitle: 'Pydantic & Pandas Cleansing Pipeline',
          code: `import pandas as pd\nimport numpy as np\n\ndef clean_fred_payload(raw_json):\n    df = pd.DataFrame(raw_json['observations'])\n    df['value'] = df['value'].replace('.', np.nan)\n    df['value'] = df['value'].astype(float)\n    df['value'] = df['value'].ffill()\n    return df`
        },
        p4: {
          badgeClass: 'badge-ok', badgeText: 'TRANSFORM OK',
          title: 'Phase 4: Multi-Currency & Unit Harmonization',
          specs: [
            '<strong>Problemstellung:</strong> US BIP liegt in Billions USD vor; DE BIP in Millions EUR.',
            '<strong>Harmonisierung:</strong> Umrechnung auf einheitlichen Basismaßstab (Mio. EUR).',
            '<strong>Metadata Tagging:</strong> Anreicherungs-Tags: `country_code`, `currency`, `frequency=Q`.'
          ],
          codeTitle: 'Pandas Currency Join',
          code: `# Harmonize US GDP to Millions USD\ndf.loc[df['country'] == 'US', 'val_mio'] = df['value'] * 1000.0\n# Apply FX Rate (USD -> EUR)\ndf['val_eur_mio'] = df['val_mio'] * df['fx_rate_usd_eur']\ndf['processed_at'] = pd.Timestamp.now(tz='UTC')`
        },
        p5: {
          badgeClass: 'badge-ok', badgeText: 'PARQUET WRITTEN',
          title: 'Phase 5: Parquet DWH Storage (DuckDB)',
          specs: [
            '<strong>Speicherformat:</strong> Apache Parquet (Spaltenorientiert, Snappy-Kompression).',
            '<strong>Verzeichnis-Partitionierung:</strong> `data/fred/country=US/series=GDPC1/data.parquet`',
            '<strong>Engine:</strong> DuckDB (In-Process SQL Engine für extrem schnelle Reads).',
            '<strong>Vorteil:</strong> 80% weniger Speicherplatz als CSV/DB.'
          ],
          codeTitle: 'DuckDB Parquet Storage (Python)',
          code: `import duckdb\n\ncon = duckdb.connect()\ncon.execute("""\n  COPY (\n    SELECT date, value, country, series_id, processed_at \n    FROM df\n  ) TO 'data/fred/country=US/gdpc1.parquet' \n  (FORMAT PARQUET, COMPRESSION SNAPPY, PARTITION_BY (country));\n""")\nprint("[STORAGE_OK] Written to Parquet DWH.")`
        }
      },
      auth: {
        p1: {
          badgeClass: 'badge-err', badgeText: 'HTTP 403 FORBIDDEN',
          title: 'Phase 1: Auth Failure (Invalid API Key)',
          specs: [
            '<strong>Fehlerdiagnose:</strong> Der übergebene FRED API Key ist ungültig oder abgelaufen.',
            '<strong>HTTP Status:</strong> `403 Forbidden` / `400 Bad Request`.',
            '<strong>Pipeline Reaktion:</strong> Abbruch des Ingestion-Jobs. Es werden keine weiteren Requests gesendet.',
            '<strong>Auto-Action:</strong> Erstellen eines Alerts & Prompt: *"API Key erneuern"*.'
          ],
          codeTitle: 'Error Log Output',
          code: `[ERROR] 2026-09-21 14:10:02 - FRED API Auth Failed!\nResponse: {"error_code": 400, "error_message": "Invalid API key specified."}\nAction: Execution HALTED. Notification sent to DevOps.`
        }
      },
      data: {
        p3: {
          badgeClass: 'badge-warn', badgeText: 'MISSING VAL (".")',
          title: 'Phase 3: Data Quality Alert (Missing Point)',
          specs: [
            '<strong>Anomalie:</strong> Das Feld `value` liefert für das Quartal den String `"."`.',
            '<strong>Ursache:</strong> FRED hat die Veröffentlichung der Zahl verzögert.',
            '<strong>Automatisierte Lösung:</strong> Weiterleitung an `Quality Guard` -> Forward-Fill mit Vorquartal + Alert im Dashboard.'
          ],
          codeTitle: 'Cleansing Log & Quality Guard Trigger',
          code: `[WARNING] Missing value '.' detected for Date: 2026-07-01 (Series: GDPC1)\n[CLEANSE] Imputing value via Forward-Fill: 28150.2 -> 28150.2\n[QUALITY_GUARD] Issue logged to Audit Trail. Pipeline continues.`
        }
      }
    };

    window.selectPhase = function(pId) {
      currentPhase = pId;
      document.querySelectorAll('.lvl4-phase-card').forEach(c => c.classList.remove('selected'));
      const card = document.getElementById(`card-${pId}`);
      if(card) card.classList.add('selected');

      let data = (phaseData[currentScenario] && phaseData[currentScenario][pId]) 
                 ? phaseData[currentScenario][pId] 
                 : phaseData['happy'][pId];

      document.getElementById('insp-title').innerText = data.title;
      document.getElementById('insp-code-title').innerText = data.codeTitle;
      document.getElementById('insp-code').innerText = data.code;

      const specsUl = document.getElementById('insp-specs');
      specsUl.innerHTML = '';
      data.specs.forEach(s => {
        const li = document.createElement('li');
        li.innerHTML = s;
        specsUl.appendChild(li);
      });
    };

    window.setScenario = function(scen) {
      currentScenario = scen;
      
      // Update Button Styles
      document.getElementById('btn-happy').className = 'lvl4-sim-btn' + (scen==='happy' ? ' active-happy' : '');
      document.getElementById('btn-auth').className = 'lvl4-sim-btn' + (scen==='auth' ? ' active-auth' : '');
      document.getElementById('btn-data').className = 'lvl4-sim-btn' + (scen==='data' ? ' active-data' : '');

      // Reset all cards to happy state first
      ['p1', 'p2', 'p3', 'p4', 'p5'].forEach(p => {
        const card = document.getElementById(`card-${p}`);
        const badge = document.getElementById(`badge-${p}`);
        card.className = 'lvl4-phase-card' + (p === currentPhase ? ' selected' : '');
        badge.className = `lvl4-badge ${phaseData.happy[p].badgeClass}`;
        badge.innerText = phaseData.happy[p].badgeText;
      });

      // Apply Scenario Overrides
      if (scen === 'auth') {
        const c = document.getElementById('card-p1');
        const b = document.getElementById('badge-p1');
        c.classList.add('error-state');
        b.className = 'lvl4-badge badge-err';
        b.innerText = phaseData.auth.p1.badgeText;
        selectPhase('p1');
      } else if (scen === 'data') {
        const c = document.getElementById('card-p3');
        const b = document.getElementById('badge-p3');
        c.classList.add('alert-state');
        b.className = 'lvl4-badge badge-warn';
        b.innerText = phaseData.data.p3.badgeText;
        selectPhase('p3');
      } else {
        selectPhase(currentPhase);
      }
    };

    // Initialize
    selectPhase('p1');
  })();
</script>
